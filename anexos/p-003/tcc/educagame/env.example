# Copie para .env e preencha. O .env fica fora do git (ver .gitignore).
#
# Em producao os mesmos nomes valem como variavel de ambiente (Render) ou
# como secret (Streamlit Cloud, em formato TOML).
#
# MELHORIA: este arquivo documentava 17 das 38 variaveis que o codigo le.
# As 21 que faltavam incluiam BREVO_API_KEY e APP_BASE_URL, sem as quais a
# confirmacao de e-mail e a recuperacao de senha nao funcionam -- e o
# GROQ_MODEL, que so causa problema quando alguem define.


# ====================== OBRIGATORIAS ======================
# Sem estas o app sobe, mas sem banco: nenhuma escola, aluno ou login.

SUPABASE_URL=sua_url_aqui
# Uma destas tres basta. O app usa service_role, que ignora RLS -- ela nunca
# pode ir para codigo que roda no navegador.
SUPABASE_SERVICE_ROLE_KEY=sua_chave_service_role_aqui
SUPABASE_KEY=sua_chave_anon_public_aqui
# SUPABASE_SERVICE_KEY=alternativa_aceita

# Assina a sessao do Flask e os tokens de e-mail. O app recusa subir sem ela.
FLASK_SECRET_KEY=sua_chave_flask_aqui


# ====================== IA (cascata) ======================
# A ordem e Groq -> Gemini -> Groq reserva -> OpenRouter.
# Sem NENHUMA delas o app funciona so com o banco offline.

GEMINI_API_KEY=sua_chave_aqui
# O padrao do codigo e o lite. O "gemini-flash-latest" vive sobrecarregado
# na faixa gratuita (503), e o "gemini-2.0-flash" saiu do catalogo do Google.
# GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_QUOTA_COOLDOWN_SECONDS=60
# Quanto tempo pular o Gemini depois de um 503 (sobrecarga do lado deles).
# Menor que o de cota: 503 passa em segundos, cota diaria so vira a janela.
GEMINI_INDISPONIVEL_COOLDOWN_SECONDS=30
# Prazo proprio do Gemini, menor que o dos outros (padrao 5, entre 1 e 25).
# Desde 15/09/2026 o Groq vem primeiro e o Gemini logo depois: sem prazo
# curto, cada falha dele comia ate 8 s do orcamento da questao.
# GEMINI_TIMEOUT_SECONDS=5
# Alternativa aceita para a chave do Gemini.
# GOOGLE_API_KEY=sua_chave_aqui

GROQ_API_KEY=sua_chave_aqui
# NAO defina GROQ_MODEL sem necessidade. O padrao do codigo ja e
# "openai/gpt-oss-120b"; definir sem o prefixo do fornecedor faz o Groq
# responder 404 a cada questao e a cascata cair no proximo provedor sem
# nenhum erro visivel. Foi assim por semanas.
# GROQ_MODEL=openai/gpt-oss-120b
# O gpt-oss raciocina antes de responder, e o raciocinio come o mesmo limite
# de tokens da resposta. O codigo ja manda "low" (medido em 02/10/2026: JSON
# valido de 13 para 16 em 17, metade do tempo). Troque o nivel com "medium"
# ou "high"; "padrao" desliga. Vazio NAO desliga.
# IA_REASONING_EFFORT=low
# Segundo modelo do Groq, na mesma chave e com cota propria (o Groq conta o
# limite por modelo). Entra depois do Gemini, com o raciocinio desligado.
# Tambem exige o prefixo do fornecedor, como o GROQ_MODEL.
# GROQ_MODEL_RESERVA=qwen/qwen3.8-27b

OPENROUTER_API_KEY=sua_chave_aqui
# NAO use "openrouter/free": ele sorteia um modelo gratuito por pedido, os
# gratuitos raciocinam, e a resposta volta vazia. O padrao do codigo e o
# Nemotron, chamado com o raciocinio desligado. Conta gratuita: 50 pedidos/dia.
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_SITE_URL=https://seu-site-ou-app-aqui
OPENROUTER_APP_NAME=EducaGame


# ====================== E-MAIL ======================
# Confirmacao de cadastro e recuperacao de senha. A prioridade e
# Brevo -> Resend -> SMTP: os dois primeiros falam HTTP, porque o Render
# bloqueia as portas de SMTP no plano free.

# BREVO_API_KEY=sua_chave_aqui
# RESEND_API_KEY=sua_chave_aqui
# EMAIL_FROM=nao-responda@seudominio.com
# EMAIL_FROM_NOME=EducaGame

# Base usada para montar o link do e-mail fora do contexto do Flask (o
# Streamlit, por exemplo). Sem ela o link aponta para o endereco padrao.
# APP_BASE_URL=https://educagame.onrender.com

# Fallback por SMTP, se algum dia as portas abrirem.
# SMTP_HOST=smtp.seuprovedor.com
# SMTP_PORT=587
# SMTP_USER=usuario
# SMTP_PASSWORD=senha
# SMTP_FROM=nao-responda@seudominio.com


# ====================== ORCAMENTO DE TEMPO DA IA ======================
# Segundos que cada modo espera pela cascata antes de usar o banco offline.
# Mexer aqui troca "questao mais demorada" por "cai offline mais cedo".

# Por modo (padrao 22, teto 26).
# ORACULO_IA_BUDGET_SECONDS=22
# LAB_IA_BUDGET_SECONDS=22
# ENEM_IA_BUDGET_SECONDS=22

# Da cascata inteira (padrao 16, teto 26) e de cada provedor (padrao 8).
# IA_CHAIN_TIMEOUT_SECONDS=16
# IA_PROVIDER_TIMEOUT_SECONDS=8


# ====================== OPERACAO ======================

# ---------- prazo da sessao (ver core/sessao.py) ----------
# Sem estas travas o login virava permanente: o cookie de sessao do Flask sai
# sem Expires, e Chrome/Edge com "continuar de onde parei" o restauram --
# abrir o site caia direto no perfil, dias depois, sem pedir escola nem senha.
#
# Minutos parados ate pedir escola e senha de novo. Padrao 30. Baixe para uma
# sala compartilhada; suba se os alunos ficam muito tempo lendo. 0 desliga.
# SESSAO_MINUTOS_INATIVIDADE=30

# Horas desde o LOGIN, com atividade ou sem. Fecha o caso da maquina que fica
# aberta o dia todo e vai sendo renovada por cliques. Padrao 12. 0 desliga.
# SESSAO_HORAS_MAXIMAS=12

# SENHA_MESTRA saiu. Ela liberava o painel ADM do Streamlit por uma senha
# unica combinada entre pessoas -- a porta mais fraca da casa, e e a porta
# mais fraca que define a tranca. O ADM agora pede usuario e senha da conta
# de desenvolvedor, nos dois frontends. Se ninguem souber essa senha, a
# reserva e rodar scripts/seed_usuarios.py, que faz upsert da conta e exige
# a chave do Supabase. Pode apagar a variavel do Render e do Streamlit Cloud.

# Porta do servidor. O Render define sozinho.
# PORT=5000

# Quantos alunos o processo do Gunicorn atende AO MESMO TEMPO (ver
# gunicorn.conf.py). Padrao 8. Com 1, um aluno esperando a IA (ate ~70 s)
# trava todos os outros e a checagem de saude do Render, que reinicia o app.
# GUNICORN_THREADS=8

# Nunca deixe ligado em producao: expoe rastreamento de erro ao usuario.
# FLASK_DEBUG=0

# O cookie de sessao sai com a flag Secure por padrao (so trafega por
# HTTPS). No Render isso e sempre o certo. So desligue localmente se voce
# testar fora de HTTPS e fora de localhost (Chrome/Edge/Firefox tratam
# http://localhost como contexto seguro, entao normalmente nem precisa).
# SESSION_COOKIE_SECURE=0

# E-mail que a pagina /privacidade mostra para quem quer pedir acesso,
# correcao ou exclusao dos proprios dados (LGPD, Art. 18). Sem esta
# variavel a pagina orienta a pedir pelo professor/escola em vez de
# inventar um contato -- defina antes de levar a politica a serio.
# PRIVACIDADE_CONTATO_EMAIL=privacidade@seudominio.com
