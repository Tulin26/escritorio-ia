{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "flask-dev",
      "runtimeExecutable": ".venv/Scripts/python",
      "runtimeArgs": ["flask_app.py"],
      "port": 5000
    },
    {
      "name": "streamlit-dev",
      "runtimeExecutable": ".venv/Scripts/python",
      "runtimeArgs": ["-m", "streamlit", "run", "app.py", "--server.port", "8501", "--server.headless", "true"],
      "port": 8501
    }
  ]
}
